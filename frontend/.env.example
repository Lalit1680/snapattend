# ---------------------------------------------------------------------------
# SnapAttend frontend configuration
#
# Copy to `.env` (or `.env.local`) and edit. Only variables prefixed with VITE_
# are exposed to the browser bundle -- never put a secret in this file, because
# everything here ships to the client in plain text.
# ---------------------------------------------------------------------------

# Base URL of the SnapAttend API.
#
# Leave EMPTY for local development: vite.config.js proxies /api to the Flask dev
# server, which keeps requests same-origin and avoids CORS entirely.
#
# For a deployed build, set the API origin explicitly and add that origin to
# CORS_ORIGINS in backend/.env:
#   VITE_API_URL=https://api.snapattend.example.edu
VITE_API_URL=

# Where the Flask dev server is listening. Only used by the dev proxy.
VITE_PROXY_TARGET=http://127.0.0.1:5000

# Optional label shown in the sidebar footer, useful when several environments
# are open in different tabs.
VITE_ENV_LABEL=
