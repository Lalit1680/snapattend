# ==========================================================================
# SnapAttend backend environment configuration
#
# Copy this file to `.env` (same directory) and fill in real values.
# `.env` is git-ignored and must never be committed.
# ==========================================================================

# --- Flask -----------------------------------------------------------------
# Used to sign invite / password-reset / QR tokens (itsdangerous) and Flask
# sessions. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=development

# --- MongoDB Atlas (source of truth) --------------------------------------
# Full SRV connection string from Atlas, e.g.
#   mongodb+srv://user:pass@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=Attendance_System

# --- JWT -------------------------------------------------------------------
# Separate secret for signing JWTs. Generate like SECRET_KEY above.
JWT_SECRET_KEY=change-me-to-a-different-long-random-string
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=14

# --- ChromaDB (embedded, local persistent mode — no server process) -------
# Directory where Chroma persists the face/voice embedding collections.
CHROMA_PERSIST_DIR=./chroma_data

# --- Email (Flask-Mail / SMTP) --------------------------------------------
# Works with any SMTP provider (Gmail app password, SendGrid, Mailgun, ...).
# For Gmail: MAIL_SERVER=smtp.gmail.com, MAIL_PORT=587, MAIL_USE_TLS=true,
# MAIL_USERNAME=you@gmail.com, MAIL_PASSWORD=<16-char app password>.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER="SnapAttend <no-reply@snapattend.app>"
# If SMTP is not configured, emails are logged to the console instead of failing
# (handy for local dev). Set MAIL_SUPPRESS_SEND=true to force console-only.
MAIL_SUPPRESS_SEND=false

# --- Frontend base URL (used to build invite / reset links in emails) -----
FRONTEND_URL=http://localhost:5173

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed origins for the SPA + mobile QR scan page.
CORS_ORIGINS=http://localhost:5173

# --- Biometric matching thresholds ----------------------------------------
# Chroma collections use cosine distance over L2-normalised vectors, so
# euclidean^2 == 2 * cosine_distance. dlib's documented Euclidean face
# tolerance of 0.6 therefore equals cosine 0.18; we default tighter for
# auto-marking. Tune these against your own enrollment data before rollout.
FACE_MATCH_THRESHOLD=0.12
# Faces between FACE_MATCH_THRESHOLD and FACE_REVIEW_CEILING become review-queue
# items (best guess shown to the teacher) instead of silent auto-marks.
FACE_REVIEW_CEILING=0.28
# Reject a match as ambiguous when the runner-up is this close to the best hit.
FACE_AMBIGUITY_MARGIN=0.04
VOICE_MATCH_THRESHOLD=0.25

# --- Vision pipeline tuning -----------------------------------------------
# hog = CPU-friendly (default). cnn = better on angled/small faces, needs a GPU
# to be usable on a dense class photo.
FACE_DETECTION_MODEL=hog
FACE_DETECTION_UPSAMPLE=1
CLASS_PHOTO_MAX_DIM=2400
ENROLLMENT_PHOTO_MAX_DIM=1200
MIN_FACE_PIXELS=48
MAX_UPLOAD_MB=16
# Privacy backstop: review-queue face crops are deleted this many hours after
# upload even if the teacher never resolves the queue.
FACE_CROP_TTL_HOURS=24

# --- QR sessions -----------------------------------------------------------
# Seconds a rotating QR token is valid before the server issues a new nonce.
QR_TOKEN_TTL_SECONDS=30

# --- Invite / reset link lifetimes ----------------------------------------
INVITE_TOKEN_MAX_AGE_HOURS=168      # 7 days
RESET_TOKEN_MAX_AGE_MINUTES=60      # 1 hour

# --- Attendance policy -----------------------------------------------------
# Default "defaulter" threshold (%). Institutions/teachers can override per subject.
DEFAULT_ATTENDANCE_THRESHOLD=75
