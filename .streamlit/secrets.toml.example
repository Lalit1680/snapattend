# Copy this file to .streamlit/secrets.toml and fill in your own Supabase
# project's values (Project Settings -> API in the Supabase dashboard).
#
# src/database/config.py reads these two keys via st.secrets, exactly as
# before — this file only documents what it expects; it changes no code.
#
# NOTE: a generic ".env.example" would be misleading here — this app doesn't
# read os.environ anywhere, it reads st.secrets, which Streamlit only loads
# from a file named exactly ".streamlit/secrets.toml". That's why this
# template uses Streamlit's own format instead of a .env file.

SUPABASE_URL = "https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_KEY = "YOUR-SUPABASE-ANON-OR-SERVICE-KEY"
